---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Kpi from '../components/Kpi.astro';
import actions from '../data/actions.json';
import { FAMILIES } from '../lib/families.mjs';

type State = 'red' | 'flapping' | 'recovered' | 'green' | 'none';
type Repo = {
  id: string;
  family: string;
  url: string;
  state: State;
  workflows: { name: string; state: Exclude<State, 'none'>; conclusion: string; lastRun: string; url: string; failures24h: number; streaks7d: number }[];
  dependabot: { job: string; since: string; url: string }[];
};

const repos = actions.repos as Repo[];
const ORDER: Record<State, number> = { red: 0, flapping: 1, recovered: 2, green: 3, none: 4 };
const LABEL: Record<State, string> = { red: 'Broken', flapping: 'Flapping', recovered: 'Recovered', green: 'Passing', none: 'No runs' };
const groups = [...FAMILIES, ['meta', 'Organisation']]
  .map(([family, label]) => [label, repos.filter((r) => r.family === family).sort((a, b) => ORDER[a.state] - ORDER[b.state] || a.id.localeCompare(b.id))] as const)
  .filter(([, list]) => list.length);
const count = (s: State) => repos.filter((r) => r.state === s).length;
const asOf = actions.generatedAt.slice(0, 16).replace('T', ' ') + ' UTC';
const day = (t: string) => t.slice(0, 10);
const detail = (w: Repo['workflows'][number]) =>
  w.state === 'red'
    ? `${w.conclusion.replace('_', ' ')} ${day(w.lastRun)}`
    : w.state === 'flapping'
      ? `${w.streaks7d} separate failures in 7 days, passing now`
      : `${w.failures24h} failed in the last day, passing now`;
---
<StarlightPage frontmatter={{ title: 'Workflows', description: 'GitHub Actions state of each public Rhizomatics repo, updated daily.', tableOfContents: false }}>
  <p>
    The GitHub Actions state of each public repo, as of {asOf}. Updated daily. A repo takes the state of its worst workflow:
  </p>
  <ul class="ci-legend">
    <li><span class="ci-status ci-status--red">Broken</span> the workflow's latest run failed.</li>
    <li><span class="ci-status ci-status--flapping">Flapping</span> passing now, but it has failed and recovered three or more times in the last 7 days.</li>
    <li><span class="ci-status ci-status--recovered">Recovered</span> passing now, after a failure in the last day.</li>
    <li><span class="ci-status ci-status--green">Passing</span> no failures in the last day.</li>
  </ul>
  <p class="ci-meta">
    Runs from pull requests, Dependabot branches and Copilot reviews are left out, so this covers the main branch,
    releases and scheduled jobs. Failing Dependabot update jobs are listed but don't change the state.
  </p>

  {actions.available ? (
    <>
      <div class="kpis">
        <Kpi label="Broken" value={String(count('red'))} note="repos" />
        <Kpi label="Flapping" value={String(count('flapping'))} note="repos" />
        <Kpi label="Recovered" value={String(count('recovered'))} note="repos" />
        <Kpi label="Passing" value={String(count('green'))} note="repos" />
      </div>

      {groups.map(([label, list]) => (
        <>
          <h2>{label}</h2>
          <table class="usage-table ci-table">
            <thead>
              <tr>
                <th scope="col">Repo</th>
                <th scope="col">State</th>
                <th scope="col">Workflows</th>
              </tr>
            </thead>
            <tbody>
              {list.map((r) => {
                const problems = r.workflows.filter((w) => w.state !== 'green');
                const passing = r.workflows.length - problems.length;
                return (
                  <tr>
                    <th scope="row"><a href={r.url}>{r.id}</a></th>
                    <td><span class={`ci-status ci-status--${r.state}`}>{LABEL[r.state]}</span></td>
                    <td>
                      {problems.length > 0 && (
                        <ul class="ci-problems">
                          {problems.map((w) => (
                            <li>
                              <span class={`ci-dot ci-dot--${w.state}`} aria-hidden="true"></span>
                              <a href={w.url}>{w.name}</a> <span class="ci-meta">{detail(w)}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                      {r.workflows.length === 0
                        ? <span class="ci-meta">No runs outside pull requests</span>
                        : passing > 0 && <span class="ci-meta">{problems.length ? '+ ' : ''}{passing} passing</span>}
                      {r.dependabot.map((d) => (
                        <div class="ci-meta">Dependabot <a href={d.url}>{d.job}</a> update failing since {day(d.since)}</div>
                      ))}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </>
      ))}
    </>
  ) : (
    <p>Workflow states weren't available at the last build.</p>
  )}

  {actions.notes.length > 0 && (
    <ul class="usage-notes">
      {actions.notes.map((n) => <li>{n}</li>)}
    </ul>
  )}
</StarlightPage>
