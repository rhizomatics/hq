---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import Kpi from '../components/Kpi.astro';
import issues from '../data/issues.json';
import { FAMILIES } from '../lib/families.mjs';

type Repo = {
  id: string;
  family: string;
  product: boolean;
  url: string;
  enabled: boolean;
  total?: number;
  counts: Record<string, number>;
  oldest: Record<string, string>;
};

const repos = (issues.repos as Repo[]).filter((r) => r.product);
const groups = FAMILIES.map(([family, label]) => [label, repos.filter((r) => r.family === family).sort((a, b) => a.id.localeCompare(b.id))] as const).filter(
  ([, list]) => list.length,
);
const n = (r: Repo, t: string) => r.counts[t] ?? 0;
const sum = (t: string) => repos.reduce((s, r) => s + n(r, t), 0);
const search = (r: Repo, q: string) => `${r.url}?q=${encodeURIComponent(`is:issue is:open ${q}`)}`;
const now = Date.parse(issues.generatedAt);
const age = (t?: string) => (t ? `${Math.max(0, Math.floor((now - Date.parse(t)) / 86_400_000))} days` : '');
const inProducts = (t: string) => {
  const k = repos.filter((r) => n(r, t)).length;
  return `open, in ${k} product${k === 1 ? '' : 's'}`;
};
const asOf = issues.generatedAt.slice(0, 16).replace('T', ' ') + ' UTC';
---
<StarlightPage frontmatter={{ title: 'Support', description: 'Open bug reports and unclassified issues for each Rhizomatics product, updated daily.', tableOfContents: false }}>
  <p>
    Open issues on each product, as of {asOf}. Updated daily. Issues are sorted with GitHub's issue types:
  </p>
  <ul>
    <li><strong>Bugs</strong> are open issues of the Bug type: something that doesn't work as it should.</li>
    <li><strong>Unclassified</strong> issues have no type yet, so nobody has sorted them into a bug, feature or task. New reports usually start here.</li>
  </ul>
  <p>
    Feature requests are counted on the <a href="/design/">Design Process</a> page. To report a problem, open an issue on the product's repo.
  </p>

  {issues.available ? (
    <>
      <div class="kpis">
        <Kpi label="Bugs" value={String(sum('bug'))} note={inProducts('bug')} />
        <Kpi label="Unclassified" value={String(sum('unclassified'))} note={inProducts('unclassified')} />
        <Kpi label="All open" value={String(repos.reduce((s, r) => s + (r.total ?? 0), 0))} note="issues" />
      </div>

      {groups.map(([label, list]) => (
        <>
          <h2>{label}</h2>
          <table class="usage-table">
            <thead>
              <tr>
                <th scope="col">Product</th>
                <th scope="col" class="num">Bugs</th>
                <th scope="col">Oldest bug</th>
                <th scope="col" class="num">Unclassified</th>
                <th scope="col">Oldest unclassified</th>
                <th scope="col" class="num">All open</th>
              </tr>
            </thead>
            <tbody>
              {list.map((r) => (
                <tr>
                  <th scope="row"><a href={r.url}>{r.id}</a></th>
                  {r.enabled ? (
                    <>
                      <td class="num">{n(r, 'bug') ? <a href={search(r, 'type:Bug')}>{n(r, 'bug')}</a> : <span class="ci-meta">0</span>}</td>
                      <td class="ci-meta">{age(r.oldest.bug)}</td>
                      <td class="num">{n(r, 'unclassified') ? <a href={search(r, 'no:type')}>{n(r, 'unclassified')}</a> : <span class="ci-meta">0</span>}</td>
                      <td class="ci-meta">{age(r.oldest.unclassified)}</td>
                      <td class="num">{r.total ? <a href={search(r, '')}>{r.total}</a> : <span class="ci-meta">0</span>}</td>
                    </>
                  ) : (
                    <td colspan="5" class="ci-meta">Issues are switched off</td>
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </>
      ))}
    </>
  ) : (
    <p>Issue counts weren't available at the last build.</p>
  )}

  <ul class="usage-notes">
    <li>Pull requests aren't counted. Experimental and internal repos aren't listed.</li>
    {issues.notes.map((note) => <li>{note}</li>)}
  </ul>
</StarlightPage>
