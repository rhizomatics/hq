---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import community from '../data/community.json';
import stats from '../data/stats.json';
import { ORG } from '../lib/hq-config.mjs';

// Projects other people have built on our products, with their figures, from @rhizomatics/hq-stats (stats.json,
// written by `hq-stats build`); the full figures are on its Usage › Community page. Blogs from build-community.mjs.
type Project = {
  id: string;
  name: string;
  url: string;
  author: string;
  authorUrl: string;
  extends: string | null;
  description: string;
  archived: boolean;
  latestRelease: { tag: string; date: string; url: string } | null;
  kpis: { stars: number | null };
};
type Blog = {
  id: string;
  url: string;
  author: string;
  note: string | null;
  title: string;
  description: string | null;
  posts: { title: string; url: string; date: string }[] | null;
  asOf?: string | null;
};
const blogs = (community.blogs ?? []) as Blog[];

const projects = ((stats as { community?: Project[] }).community ?? []) as Project[];
const products = [...new Set(projects.map((p) => p.extends ?? ''))].map((id) => ({
  id,
  url: `https://github.com/${ORG.github}/${id}`,
  projects: projects.filter((p) => (p.extends ?? '') === id),
}));
const count = projects.length;
const day = (t: string) => t.slice(0, 10);
const usage = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/usage/community/`;
const asOf = community.generatedAt.slice(0, 16).replace('T', ' ') + ' UTC';
---
<StarlightPage frontmatter={{ title: 'Community', description: `Projects other people have built on ${ORG.name} products: plugins, cards and more.`, tableOfContents: false }}>
  <p>
    Projects other people have built on {ORG.name} products, grouped by the product they extend. They're made and
    maintained by their authors, not by us; thank you to everyone who has built one.
  </p>
  <p>
    Built something on one of our products? Open an issue or discussion on that product's repo and we'll add it here.
    If you'd rather yours wasn't listed, say so the same way.
  </p>

  {count > 0 && <p>Downloads and trends for each project are on <a href={usage}>Usage › Community</a>.</p>}

  {count ? (
    products.map((product) => (
      <>
        <h2>{product.id ? <>For <a href={product.url}>{product.id}</a></> : 'Other'}</h2>
        <table class="usage-table">
          <thead>
            <tr>
              <th scope="col">Project</th>
              <th scope="col">By</th>
              <th scope="col">What it does</th>
              <th scope="col">Latest release</th>
              <th scope="col" class="num">Stars</th>
            </tr>
          </thead>
          <tbody>
            {product.projects.map((p) => (
              <tr>
                <th scope="row"><a href={p.url}>{p.name}</a>{p.archived && <span class="ci-meta"> (archived)</span>}</th>
                <td><a href={p.authorUrl}>{p.author}</a></td>
                <td>{p.description}</td>
                <td>{p.latestRelease ? <a href={p.latestRelease.url}>{p.latestRelease.tag}</a> : ''}{p.latestRelease && <span class="ci-meta"> {day(p.latestRelease.date)}</span>}</td>
                <td class="num">{p.kpis.stars ?? ''}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    ))
  ) : (
    <p>No community projects listed yet.</p>
  )}

  {blogs.length > 0 && (
    <>
      <h2>Blogs</h2>
      <p>Writing about our products and the platforms they run on.</p>
      {blogs.map((b) => (
        <section class="community-blog">
          <h3><a href={b.url}>{b.title}</a></h3>
          <p class="ci-meta">By {b.author}{b.note && <> · {b.note}</>}</p>
          {b.description && <p>{b.description}</p>}
          {b.posts === null ? (
            <p class="ci-meta">Latest posts couldn't be loaded at the last build; <a href={b.url}>see the blog</a>.</p>
          ) : b.posts.length > 0 ? (
            <ul>
              {b.asOf && <li class="ci-meta">Latest posts as of {day(b.asOf)}</li>}
              {b.posts.map((post) => (
                <li><a href={post.url}>{post.title}</a> <span class="ci-meta">{day(post.date)}</span></li>
              ))}
            </ul>
          ) : (
            <p class="ci-meta">No posts yet.</p>
          )}
        </section>
      ))}
    </>
  )}

  <ul class="usage-notes">
    <li>Projects as of {stats.snapshotDate}, blogs as of {asOf}. Figures come from each project's public GitHub data and are never added to {ORG.name}'s own usage.</li>
    {community.notes.map((note) => <li>{note}</li>)}
  </ul>
</StarlightPage>
